{
  "name": "loomark-open-in-loomark",
  "displayName": "loomark: Open in loomark",
  "description": "Open the current Markdown file in loomark. Unsaved changes are saved to disk first so loomark's file watcher can see them.",
  "version": "0.1.0",
  "publisher": "loomark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marswaveai/loomark.git",
    "directory": "vscode-extension"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "loomark",
    "markdown",
    "editor"
  ],
  "activationEvents": [
    "onCommand:loomark.openCurrentMarkdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loomark.openCurrentMarkdown",
        "title": "loomark: Open Current Markdown in loomark"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "loomark.openCurrentMarkdown",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/context": [
        {
          "command": "loomark.openCurrentMarkdown",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "loomark",
      "properties": {
        "loomark.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional path or name of the loomark executable. When empty, the platform default is used: macOS `open -a loomark <file>`, Linux `loomark <file>`, Windows `loomark.exe <file>`. Set this to a full path when loomark is not on PATH, e.g. `C:\\Program Files\\loomark\\loomark.exe`."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx --yes @vscode/vsce package"
  }
}
