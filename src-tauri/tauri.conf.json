{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loomark",
  "version": "2.8.6",
  "identifier": "com.loomark.app",
  "build": {
    "frontendDist": "../dist-tauri/renderer",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:tauri:renderer",
    "beforeBuildCommand": "npm run build:tauri:renderer"
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "../resources/icons/32x32.png",
      "../resources/icons/128x128.png",
      "../resources/icon.icns",
      "../resources/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "A free, elegant Markdown editor",
    "longDescription": "A free, elegant Markdown editor. Simple by design, always in sync with the file on disk.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
